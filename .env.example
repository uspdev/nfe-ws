# Diretório para armazenamento dos arquivos da NFe (XMLs, DANFEs, protocolos)
# Pode ser um caminho relativo à raiz do projeto ou absoluto
NFE_LOCAL_PATH=local/recebidas/

# Certificado Digital ICP-Brasil A1 (formato PFX)
NFE_CERT_FILE=local/certs/certificado.pfx
NFE_CERT_PASSWORD=sua-senha-aqui

# Arquivo com hashes das API keys autorizadas
NFE_PASSWD_FILE=local/passwd.txt

# URL base do webservice (usada na geração dos links de download)
NFE_BASE_URL=http://servidor/nfe-ws/api/

# Modo de depuração (true/false)
NFE_DEBUG=false

# Versão da aplicação NFE-WS
NFE_APP_VERSAO=2.0.8

# Cache da consulta à SEFAZ em segundos (evita Rejeição 656: Consumo Indevido)
NFE_CACHE_SEFAZ_TTL=600

# Reutilizar arquivos PDF já gerados em disco (DANFE e relatório SEFAZ)
NFE_CACHE_PDF=true

# Parâmetros NFePHP
NFE_TP_AMB=1
NFE_RAZAO_SOCIAL="Escola de Engenharia de São Carlos"
NFE_CNPJ=63025530002824
NFE_SIGLA_UF=SP
#NFE_SCHEMES=PL009_V4
NFE_SCHEMES=PL_010g
NFE_VERSAO=4.00
