# Configurações do NFE-WS (.env.example)
#
# As variáveis descomentadas são obrigatórias para o funcionamento do webservice.
# As variáveis comentadas (#) já possuem valores padrão predefinidos na aplicação
# e só precisam ser descomentadas caso você deseje sobrescrevê-las.

# URL base pública do webservice terminada em barra (Obrigatório)
NFE_BASE_URL=http://servidor/nfe-ws/api/

# Modo de depuração: true para exibir erros detalhados, false em produção
# NFE_DEBUG=false

# Certificado Digital ICP-Brasil A1 em formato PFX (Obrigatório)
NFE_CERT_FILE=local/certs/certificado.pfx

# Senha do Certificado Digital ICP-Brasil A1 (Obrigatório)
NFE_CERT_PASSWORD=sua-senha-aqui

# ------------------------------------------------------------------------------
# Dados da Instituição / Emitente (Obrigatórios)
# ------------------------------------------------------------------------------
# Razão Social da instituição ou emitente
NFE_RAZAO_SOCIAL=""

# CNPJ da instituição ou emitente (apenas números)
NFE_CNPJ=

# Sigla da unidade federativa da SEFAZ autorizadora
NFE_SIGLA_UF=SP

# Caminhos de Arquivos podem ser relativos à raiz do projeto ou caminhos absolutos
# NFE_LOCAL_PATH=local/recebidas/
# NFE_PASSWD_FILE=local/passwd.txt

# Versão do webservice NFE-WS
# NFE_APP_VERSAO=2.0.8

# Validade do cache local da consulta SEFAZ em segundos (evita Rejeição 656)
# NFE_CACHE_SEFAZ_TTL=600

# Reutilizar arquivos PDF já gerados em disco para DANFE e SEFAZ
# NFE_CACHE_PDF=true

# ------------------------------------------------------------------------------
# Parâmetros da Biblioteca NFePHP 
# Tipo de Ambiente: 1=Produção, 2=Homologação
# NFE_TP_AMB=1

# Versão dos esquemas XML da SEFAZ
# NFE_SCHEMES=PL_010g

# Versão do leiaute da NF-e
# NFE_VERSAO=4.00
